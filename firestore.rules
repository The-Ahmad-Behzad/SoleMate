rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read access to everyone, but restrict writes to authenticated users
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Example: Protect 'users' collection — each user can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
