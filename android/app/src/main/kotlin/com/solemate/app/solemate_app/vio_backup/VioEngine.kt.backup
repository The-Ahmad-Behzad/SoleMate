package com.solemate.app.solemate_app

import android.util.Log
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.locks.ReentrantLock
import kotlin.concurrent.withLock

/**
 * Kotlin wrapper for native VIO engine.
 * Manages lifecycle and provides thread-safe access to pose tracking.
 * 
 * BACKUP: This file was backed up before implementing SimpleCamera solution.
 * Original location: android/app/src/main/kotlin/com/solemate/app/solemate_app/VioEngine.kt
 */
class VioEngine {
    companion object {
        private const val TAG = "VioEngine"
        
        init {
            try {
                System.loadLibrary("vio-engine")
                Log.d(TAG, "VIO engine native library loaded")
            } catch (e: UnsatisfiedLinkError) {
                Log.e(TAG, "Failed to load VIO engine native library: ${e.message}")
                throw e
            }
        }
    }

    private val isInitialized = AtomicBoolean(false)
    private val isStarted = AtomicBoolean(false)
    private val lock = ReentrantLock()

    // Native method declarations
    private external fun nativeInit(
        imageWidth: Int,
        imageHeight: Int,
        fx: Float,
        fy: Float,
        cx: Float,
        cy: Float
    ): Long

    private external fun nativeStart(): Boolean
    private external fun nativeStop()
    private external fun nativeRelease()
    private external fun nativeFeedFrame(
        yuvData: ByteArray,
        width: Int,
        height: Int,
        timestampNs: Long
    ): Boolean

    private external fun nativeFeedImu(
        accelX: Float,
        accelY: Float,
        accelZ: Float,
        gyroX: Float,
        gyroY: Float,
        gyroZ: Float,
        timestampNs: Long
    ): Boolean

    private external fun nativeGetPose(
        poseMatrix: FloatArray,
        covariance: FloatArray?
    ): Boolean

    private external fun nativeGetIntrinsics(intrinsics: FloatArray)
    private external fun nativeIsTracking(): Boolean

    /**
     * Initialize VIO engine with camera intrinsics.
     * @param imageWidth Camera image width
     * @param imageHeight Camera image height
     * @param fx Focal length X
     * @param fy Focal length Y
     * @param cx Principal point X
     * @param cy Principal point Y
     * @return true if initialization successful
     */
    fun init(
        imageWidth: Int,
        imageHeight: Int,
        fx: Float,
        fy: Float,
        cx: Float,
        cy: Float
    ): Boolean {
        return lock.withLock {
            if (isInitialized.get()) {
                Log.w(TAG, "VIO engine already initialized")
                return false
            }

            try {
                val result = nativeInit(imageWidth, imageHeight, fx, fy, cx, cy)
                if (result != 0L) {
                    isInitialized.set(true)
                    Log.d(TAG, "VIO engine initialized: ${imageWidth}x${imageHeight}")
                    true
                } else {
                    Log.e(TAG, "Failed to initialize VIO engine")
                    false
                }
            } catch (e: Exception) {
                Log.e(TAG, "Exception during VIO initialization: ${e.message}", e)
                false
            }
        }
    }

    /**
     * Start VIO tracking.
     * @return true if started successfully
     */
    fun start(): Boolean {
        return lock.withLock {
            if (!isInitialized.get()) {
                Log.e(TAG, "Cannot start: VIO engine not initialized")
                return false
            }

            if (isStarted.get()) {
                Log.w(TAG, "VIO engine already started")
                return true
            }

            try {
                val result = nativeStart()
                if (result) {
                    isStarted.set(true)
                    Log.d(TAG, "VIO engine started")
                } else {
                    Log.e(TAG, "Failed to start VIO engine")
                }
                result
            } catch (e: Exception) {
                Log.e(TAG, "Exception during VIO start: ${e.message}", e)
                false
            }
        }
    }

    /**
     * Stop VIO tracking.
     */
    fun stop() {
        lock.withLock {
            if (!isStarted.get()) {
                return
            }

            try {
                nativeStop()
                isStarted.set(false)
                Log.d(TAG, "VIO engine stopped")
            } catch (e: Exception) {
                Log.e(TAG, "Exception during VIO stop: ${e.message}", e)
            }
        }
    }

    /**
     * Release VIO engine resources.
     */
    fun release() {
        lock.withLock {
            if (!isInitialized.get()) {
                return
            }

            try {
                stop()
                nativeRelease()
                isInitialized.set(false)
                Log.d(TAG, "VIO engine released")
            } catch (e: Exception) {
                Log.e(TAG, "Exception during VIO release: ${e.message}", e)
            }
        }
    }

    /**
     * Feed camera frame to VIO engine.
     * @param yuvData YUV420 format image data
     * @param width Image width
     * @param height Image height
     * @param timestampNs Timestamp in nanoseconds
     * @return true if frame was processed successfully
     */
    fun feedFrame(
        yuvData: ByteArray,
        width: Int,
        height: Int,
        timestampNs: Long
    ): Boolean {
        if (!isStarted.get()) {
            return false
        }

        return try {
            nativeFeedFrame(yuvData, width, height, timestampNs)
        } catch (e: Exception) {
            Log.e(TAG, "Exception feeding frame: ${e.message}", e)
            false
        }
    }

    /**
     * Feed IMU data to VIO engine.
     * @param accelX Accelerometer X (m/s^2)
     * @param accelY Accelerometer Y (m/s^2)
     * @param accelZ Accelerometer Z (m/s^2)
     * @param gyroX Gyroscope X (rad/s)
     * @param gyroY Gyroscope Y (rad/s)
     * @param gyroZ Gyroscope Z (rad/s)
     * @param timestampNs Timestamp in nanoseconds
     * @return true if IMU data was processed successfully
     */
    fun feedImu(
        accelX: Float,
        accelY: Float,
        accelZ: Float,
        gyroX: Float,
        gyroY: Float,
        gyroZ: Float,
        timestampNs: Long
    ): Boolean {
        if (!isStarted.get()) {
            return false
        }

        return try {
            nativeFeedImu(accelX, accelY, accelZ, gyroX, gyroY, gyroZ, timestampNs)
        } catch (e: Exception) {
            Log.e(TAG, "Exception feeding IMU: ${e.message}", e)
            false
        }
    }

    /**
     * Get current pose estimate.
     * @param poseMatrix Output: 4x4 transformation matrix (column-major, 16 floats)
     * @param covariance Optional output: 6x6 covariance matrix (36 floats)
     * @return true if pose is valid and retrieved successfully
     */
    fun getPose(poseMatrix: FloatArray, covariance: FloatArray? = null): Boolean {
        if (!isStarted.get() || poseMatrix.size < 16) {
            return false
        }

        return try {
            nativeGetPose(poseMatrix, covariance)
        } catch (e: Exception) {
            Log.e(TAG, "Exception getting pose: ${e.message}", e)
            false
        }
    }

    /**
     * Get camera intrinsics.
     * @return FloatArray of [fx, fy, cx, cy] or null on error
     */
    fun getIntrinsics(): FloatArray? {
        if (!isInitialized.get()) {
            return null
        }

        return try {
            val intrinsics = FloatArray(4)
            nativeGetIntrinsics(intrinsics)
            intrinsics
        } catch (e: Exception) {
            Log.e(TAG, "Exception getting intrinsics: ${e.message}", e)
            null
        }
    }

    /**
     * Check if VIO is currently tracking.
     */
    fun isTracking(): Boolean {
        if (!isInitialized.get()) {
            return false
        }

        return try {
            nativeIsTracking()
        } catch (e: Exception) {
            Log.e(TAG, "Exception checking tracking state: ${e.message}", e)
            false
        }
    }
}




