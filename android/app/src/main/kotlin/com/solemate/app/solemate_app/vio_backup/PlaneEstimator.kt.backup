package com.solemate.app.solemate_app

import android.util.Log
import kotlin.math.*
import java.util.concurrent.locks.ReentrantLock
import kotlin.concurrent.withLock

/**
 * Estimates floor planes using RANSAC over tracked 3D points.
 * Uses gravity alignment from IMU data to improve accuracy.
 */
class PlaneEstimator {
    companion object {
        private const val TAG = "PlaneEstimator"
        private const val RANSAC_ITERATIONS = 1000
        private const val RANSAC_THRESHOLD = 0.05f  // 5cm threshold
        private const val MIN_INLIERS = 10
        private const val MIN_POINTS_FOR_PLANE = 3
    }

    private val lock = ReentrantLock()
    private val trackedPoints = mutableListOf<Point3D>()
    private val maxPoints = 500  // Limit memory usage
    
    // Gravity vector from IMU (normalized)
    private var gravityVector = floatArrayOf(0f, -1f, 0f)  // Default: down
    
    // Current best plane estimate
    private var currentPlane: PlaneEstimate? = null

    data class Point3D(
        val x: Float,
        val y: Float,
        val z: Float,
        val confidence: Float = 1.0f
    )

    data class PlaneEstimate(
        val normal: FloatArray,  // [nx, ny, nz] - normalized
        val point: FloatArray,   // [px, py, pz] - point on plane
        val inlierCount: Int,
        val extentX: Float,
        val extentZ: Float
    ) {
        override fun equals(other: Any?): Boolean {
            if (this === other) return true
            if (javaClass != other?.javaClass) return false
            other as PlaneEstimate
            return normal.contentEquals(other.normal) &&
                   point.contentEquals(other.point) &&
                   inlierCount == other.inlierCount
        }

        override fun hashCode(): Int {
            var result = normal.contentHashCode()
            result = 31 * result + point.contentHashCode()
            result = 31 * result + inlierCount
            return result
        }
    }

    /**
     * Update gravity vector from IMU data.
     * @param accelX Accelerometer X (m/s^2)
     * @param accelY Accelerometer Y (m/s^2)
     * @param accelZ Accelerometer Z (m/s^2)
     */
    fun updateGravity(accelX: Float, accelY: Float, accelZ: Float) {
        lock.withLock {
            val norm = sqrt(accelX * accelX + accelY * accelY + accelZ * accelZ)
            if (norm > 0.1f) {  // Avoid division by zero
                gravityVector[0] = accelX / norm
                gravityVector[1] = accelY / norm
                gravityVector[2] = accelZ / norm
            }
        }
    }

    /**
     * Add a tracked 3D point (typically from VIO or depth estimation).
     * Points near the bottom of the view are preferred for floor detection.
     */
    fun addPoint(point: Point3D) {
        lock.withLock {
            trackedPoints.add(point)
            
            // Keep only recent points to limit memory
            if (trackedPoints.size > maxPoints) {
                trackedPoints.removeAt(0)
            }
        }
    }

    /**
     * Clear all tracked points.
     */
    fun clearPoints() {
        lock.withLock {
            trackedPoints.clear()
            currentPlane = null
        }
    }

    /**
     * Estimate plane using RANSAC with gravity prior.
     * @return PlaneEstimate if successful, null otherwise
     */
    fun estimatePlane(): PlaneEstimate? {
        return lock.withLock {
            if (trackedPoints.size < MIN_POINTS_FOR_PLANE) {
                return null
            }

            // Filter points: prefer lower Y values (floor is typically below camera)
            val candidatePoints = trackedPoints.filter { it.y < 0.5f }  // Below 50cm
            
            if (candidatePoints.size < MIN_POINTS_FOR_PLANE) {
                // Fall back to all points if not enough floor candidates
                return estimatePlaneRansac(trackedPoints)
            }

            estimatePlaneRansac(candidatePoints)
        }
    }

    /**
     * RANSAC plane fitting with gravity alignment.
     */
    private fun estimatePlaneRansac(points: List<Point3D>): PlaneEstimate? {
        if (points.size < MIN_POINTS_FOR_PLANE) {
            return null
        }

        var bestPlane: PlaneEstimate? = null
        var maxInliers = 0

        // Try RANSAC iterations
        repeat(RANSAC_ITERATIONS) {
            // Randomly select 3 points
            val indices = (0 until points.size).shuffled().take(3)
            val p1 = points[indices[0]]
            val p2 = points[indices[1]]
            val p3 = points[indices[2]]

            // Compute plane from 3 points
            val v1 = floatArrayOf(p2.x - p1.x, p2.y - p1.y, p2.z - p1.z)
            val v2 = floatArrayOf(p3.x - p1.x, p3.y - p1.y, p3.z - p1.z)
            
            // Cross product for normal
            val normal = floatArrayOf(
                v1[1] * v2[2] - v1[2] * v2[1],
                v1[2] * v2[0] - v1[0] * v2[2],
                v1[0] * v2[1] - v1[1] * v2[0]
            )
            
            val norm = sqrt(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2])
            if (norm < 0.001f) {
                return@repeat  // Degenerate case
            }
            
            // Normalize
            normal[0] /= norm
            normal[1] /= norm
            normal[2] /= norm
            
            // Enforce gravity alignment: prefer planes with normal aligned with gravity
            // For floor, normal should point up (opposite to gravity)
            val gravityAlignment = abs(normal[0] * gravityVector[0] + 
                                      normal[1] * gravityVector[1] + 
                                      normal[2] * gravityVector[2])
            
            // Prefer horizontal planes (normal aligned with gravity)
            if (gravityAlignment < 0.7f) {
                return@repeat  // Not horizontal enough
            }
            
            // Ensure normal points up (for floor detection)
            if (normal[1] < 0) {
                normal[0] = -normal[0]
                normal[1] = -normal[1]
                normal[2] = -normal[2]
            }
            
            // Count inliers
            val inliers = points.count { point ->
                val dist = abs(
                    normal[0] * (point.x - p1.x) +
                    normal[1] * (point.y - p1.y) +
                    normal[2] * (point.z - p1.z)
                )
                dist < RANSAC_THRESHOLD
            }
            
            if (inliers > maxInliers && inliers >= MIN_INLIERS) {
                maxInliers = inliers
                
                // Compute plane center and extent from inliers
                val inlierPoints = points.filter { point ->
                    val dist = abs(
                        normal[0] * (point.x - p1.x) +
                        normal[1] * (point.y - p1.y) +
                        normal[2] * (point.z - p1.z)
                    )
                    dist < RANSAC_THRESHOLD
                }
                
                val centerX = inlierPoints.map { it.x }.average().toFloat()
                val centerY = inlierPoints.map { it.y }.average().toFloat()
                val centerZ = inlierPoints.map { it.z }.average().toFloat()
                
                // Compute extent (simplified: use bounding box)
                val xCoords = inlierPoints.map { it.x }
                val zCoords = inlierPoints.map { it.z }
                val extentX = (xCoords.maxOrNull() ?: 0f) - (xCoords.minOrNull() ?: 0f)
                val extentZ = (zCoords.maxOrNull() ?: 0f) - (zCoords.minOrNull() ?: 0f)
                
                bestPlane = PlaneEstimate(
                    normal = normal,
                    point = floatArrayOf(centerX, centerY, centerZ),
                    inlierCount = inliers,
                    extentX = max(extentX, 0.5f),  // Minimum extent
                    extentZ = max(extentZ, 0.5f)
                )
            }
        }

        if (bestPlane != null) {
            currentPlane = bestPlane
            Log.d(TAG, "Plane estimated: inliers=${bestPlane.inlierCount}, extent=${bestPlane.extentX}x${bestPlane.extentZ}")
        }

        return bestPlane
    }

    /**
     * Get current plane estimate as PlaneInfo.
     */
    fun getPlaneInfo(): PlaneInfo? {
        return lock.withLock {
            val plane = currentPlane ?: estimatePlane() ?: return null
            
            // Convert to PlaneInfo
            val translation = plane.point
            val normal = plane.normal
            
            // Create rotation quaternion from normal (assuming Y-up)
            // For floor plane, normal is [0, 1, 0] ideally
            val quaternion = floatArrayOf(0f, 0f, 0f, 1f)  // Identity for horizontal plane
            
            val pose = Pose(translation, quaternion)
            
            PlaneInfo(
                centerPose = pose,
                extentX = plane.extentX,
                extentZ = plane.extentZ,
                polygon = null,  // Could compute from inliers if needed
                trackingState = TrackingState.TRACKING
            )
        }
    }
}



