    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="solemate_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Snap Camera Kit API Token -->
        <!-- TODO: Paste your Snap Kit API Token here -->
